<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to read/receive the Till SIM's incoming M-Pesa SMS -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Required to keep the SMS listener alive while the app is backgrounded -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Required to show the persistent "listener active" notification on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required to prompt the user to exempt the app from battery optimizations,
         so the background SMS listener isn't throttled/killed by the OS -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Required to restart the listener's foreground service after a device
         reboot, since both the process and any AlarmManager alarms are wiped
         on every boot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>

        <!-- Foreground service that keeps startListening()'s BroadcastReceiver
             alive in the background so a payment SMS isn't silently dropped
             when Android kills the backgrounded process. -->
        <service
            android:name=".SmsForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false"
            android:label="Webazi SMS Listener" />

        <!-- Fired every ~5 minutes by AlarmManager while the listener is
             active. Restarts SmsForegroundService if Android silently killed
             it — the self-healing heartbeat loop. -->
        <receiver
            android:name=".SmsHeartbeatReceiver"
            android:exported="false" />

        <!-- Restarts the listener's foreground service (and re-arms the
             heartbeat) after a reboot, if it was active beforehand. Optionally
             relaunches the app 5 seconds later if "Auto-relaunch app after
             reboot" is enabled. -->
        <receiver
            android:name=".SmsBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
